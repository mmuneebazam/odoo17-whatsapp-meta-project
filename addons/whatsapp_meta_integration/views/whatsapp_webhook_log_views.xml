<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_webhook_log_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.webhook.log.tree</field>
        <field name="model">whatsapp.webhook.log</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="event_type" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="result"/>
            </tree>
        </field>
    </record>

    <record id="whatsapp_webhook_log_view_form" model="ir.ui.view">
        <field name="name">whatsapp.webhook.log.form</field>
        <field name="model">whatsapp.webhook.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="event_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="result"/>
                        </group>
                    </group>
                    <group string="Raw Payload">
                        <field name="payload" nolabel="1" colspan="2" widget="ace" options="{'mode': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_webhook_log_action" model="ir.actions.act_window">
        <field name="name">Webhook Logs</field>
        <field name="res_model">whatsapp.webhook.log</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
