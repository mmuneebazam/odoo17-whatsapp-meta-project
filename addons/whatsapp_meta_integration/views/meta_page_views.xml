<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meta_page_view_tree" model="ir.ui.view">
        <field name="name">meta.page.tree</field>
        <field name="model">meta.page</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="page_id"/>
                <field name="portfolio_id"/>
                <field name="instagram_id"/>
                <field name="linked_ok" widget="boolean_toggle"/>
                <field name="messaging_permission" widget="badge"
                       decoration-success="messaging_permission == 'granted'"
                       decoration-warning="messaging_permission == 'requested'"
                       decoration-danger="messaging_permission == 'missing'"/>
            </tree>
        </field>
    </record>

    <record id="meta_page_view_form" model="ir.ui.view">
        <field name="name">meta.page.form</field>
        <field name="model">meta.page</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="page_id"/>
                            <field name="portfolio_id"/>
                            <field name="instagram_id"/>
                        </group>
                        <group>
                            <field name="linked_ok"/>
                            <field name="messaging_permission" widget="statusbar"
                                   options="{'clickable': '1'}"/>
                        </group>
                    </group>
                    <group string="Admin / Roles">
                        <field name="admin_notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="meta_page_action" model="ir.actions.act_window">
        <field name="name">Facebook Pages</field>
        <field name="res_model">meta.page</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
