<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meta_app_review_view_tree" model="ir.ui.view">
        <field name="name">meta.app.review.tree</field>
        <field name="model">meta.app.review</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-warning="status in ('preparing', 'submitted', 'in_review')"
                       decoration-danger="status == 'rejected'"/>
                <field name="submitted_date"/>
            </tree>
        </field>
    </record>

    <record id="meta_app_review_view_form" model="ir.ui.view">
        <field name="name">meta.app.review.form</field>
        <field name="model">meta.app.review</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="status" widget="statusbar"
                                   options="{'clickable': '1'}"/>
                            <field name="submitted_date"/>
                        </group>
                    </group>
                    <group string="Permissions Requested (minimum scope)">
                        <field name="permissions_requested" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Use Case Description">
                        <field name="use_case_description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Result Notes">
                        <field name="result_notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="meta_app_review_action" model="ir.actions.act_window">
        <field name="name">Meta App Review</field>
        <field name="res_model">meta.app.review</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
