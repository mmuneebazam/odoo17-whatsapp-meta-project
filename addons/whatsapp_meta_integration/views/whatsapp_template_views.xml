<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_template_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.template.tree</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="template_name"/>
                <field name="language_code"/>
                <field name="category" widget="badge"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-warning="status == 'submitted'"
                       decoration-danger="status == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="whatsapp_template_view_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_name"/>
                            <field name="language_code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="status" widget="statusbar"
                                   options="{'clickable': '1'}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Template Body">
                        <field name="body" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_template_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Message Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a WhatsApp message template</p>
            <p>Templates must be approved in Meta Business Manager before they can be sent
            for notifications or marketing.</p>
        </field>
    </record>
</odoo>
