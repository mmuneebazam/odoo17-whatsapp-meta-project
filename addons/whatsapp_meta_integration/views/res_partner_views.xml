<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_whatsapp_conversations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp"
                        help="WhatsApp conversations with this contact">
                    <field name="whatsapp_conversation_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="after">
                <field name="whatsapp_number" widget="phone"/>
            </xpath>
        </field>
    </record>
</odoo>
