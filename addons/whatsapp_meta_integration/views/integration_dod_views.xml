<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="integration_dod_view_tree" model="ir.ui.view">
        <field name="name">integration.dod.tree</field>
        <field name="model">integration.dod</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-success="done">
                <field name="done" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="verified_by"/>
                <field name="verification_date"/>
            </tree>
        </field>
    </record>

    <record id="integration_dod_view_form" model="ir.ui.view">
        <field name="name">integration.dod.form</field>
        <field name="model">integration.dod</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="done"/>
                        </group>
                        <group>
                            <field name="verified_by"/>
                            <field name="verification_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="integration_dod_action" model="ir.actions.act_window">
        <field name="name">Definition of Done</field>
        <field name="res_model">integration.dod</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
