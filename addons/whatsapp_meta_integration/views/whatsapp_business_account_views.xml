<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_business_account_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.business.account.tree</field>
        <field name="model">whatsapp.business.account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="waba_id"/>
                <field name="portfolio_id"/>
                <field name="cloud_api_status" widget="badge"
                       decoration-success="cloud_api_status == 'verified'"
                       decoration-info="cloud_api_status == 'registered'"
                       decoration-danger="cloud_api_status == 'error'"/>
                <field name="quality_status" widget="badge"/>
                <field name="coexistence_confirmed" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="whatsapp_business_account_view_form" model="ir.ui.view">
        <field name="name">whatsapp.business.account.form</field>
        <field name="model">whatsapp.business.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Acme WhatsApp Business Account"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="waba_id"/>
                            <field name="portfolio_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="cloud_api_status" widget="statusbar"
                                   options="{'clickable': '1'}"/>
                            <field name="quality_status" widget="badge"/>
                        </group>
                    </group>
                    <group string="Mobile App Coexistence (hard constraint)">
                        <field name="coexistence_eligible"/>
                        <field name="coexistence_confirmed"/>
                        <field name="coexistence_signoff_date"/>
                        <field name="coexistence_notes" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Phone Numbers" name="phone_numbers">
                            <field name="phone_number_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="phone_number" widget="phone"/>
                                    <field name="phone_number_id"/>
                                    <field name="verified" widget="boolean_toggle"/>
                                    <field name="quality_rating"/>
                                    <field name="connection_status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_business_account_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Business Accounts</field>
        <field name="res_model">whatsapp.business.account</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first WhatsApp Business Account</p>
            <p>Register the WABA ID from Meta Business Manager and confirm mobile-app
            coexistence eligibility before connecting Odoo.</p>
        </field>
    </record>
</odoo>
