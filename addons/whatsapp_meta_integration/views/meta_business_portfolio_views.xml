<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meta_business_portfolio_view_tree" model="ir.ui.view">
        <field name="name">meta.business.portfolio.tree</field>
        <field name="model">meta.business.portfolio</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="business_id"/>
                <field name="verification_status" widget="badge"
                       decoration-success="verification_status == 'verified'"
                       decoration-warning="verification_status in ('pending', 'under_review')"
                       decoration-danger="verification_status == 'rejected'"/>
                <field name="owner_id"/>
                <field name="asset_count"/>
            </tree>
        </field>
    </record>

    <record id="meta_business_portfolio_view_form" model="ir.ui.view">
        <field name="name">meta.business.portfolio.form</field>
        <field name="model">meta.business.portfolio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Acme Business Portfolio"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="business_id"/>
                            <field name="owner_id"/>
                            <field name="admin_user_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="verification_status" widget="statusbar"
                                   options="{'clickable': '1'}"/>
                            <field name="verification_date"/>
                            <field name="asset_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Facebook Pages" name="pages">
                            <field name="page_ids"/>
                        </page>
                        <page string="Instagram Accounts" name="instagram">
                            <field name="instagram_ids"/>
                        </page>
                        <page string="WhatsApp Business Accounts" name="waba">
                            <field name="waba_ids"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="meta_business_portfolio_action" model="ir.actions.act_window">
        <field name="name">Business Portfolios</field>
        <field name="res_model">meta.business.portfolio</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your Meta Business Portfolio</p>
            <p>Phase 1: verify the Business Portfolio, confirm client ownership and assign
            the Page, Instagram account and WABA to it.</p>
        </field>
    </record>
</odoo>
